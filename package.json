{
  "name": "manak-setu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma": "dotenv -e .env -- prisma",
    "db:generate": "pnpm prisma generate",
    "db:push": "pnpm prisma db push",
    "db:migrate": "pnpm prisma migrate dev",
    "db:studio": "pnpm prisma studio",
    "db:seed": "dotenv -e .env -- tsx scripts/seed/seed.ts",
    "eval:rag": "dotenv -e .env -- tsx scripts/evaluation/evaluate_rag.ts",
    "clean": "pnpm dlx rimraf --glob \"./node_modules\" \"./apps/**/node_modules\" \"./packages/**/node_modules\" \"./.turbo\" \"./apps/**/.turbo\" \"./packages/**/.turbo\" \"./apps/**/dist\" \"./packages/**/dist\" \"./apps/web/.next\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@11.25.0"
}
